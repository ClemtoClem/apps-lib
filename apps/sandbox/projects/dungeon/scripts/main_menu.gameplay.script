# ── Menu-principal : graine du donjon et difficulté ──────────────────────────

const sounds = import "sounds"

const DIFFICULTIES = ["Easy", "Normal", "Hard"]

# Un clic de bouton : un petit choc de bois.
fn Click() { sounds.Variant("default_wood_hit", {volume: 0.35, pitch: sounds.Rand(1.25, 1.4)}) }

# Le crâne du décor oscille doucement.
class Sway extends Behaviour {
    let time = 0
    fn OnUpdate(dt) {
        this.time += dt
        this.set_rotation(0, math.sin(this.time * 0.8) * 25, 0)
    }
}

class MainMenu extends Scene {
    let seed = 1234
    let difficulty = "Normal"
    let field = nil
    let buttons = []
    let ambience = nil

    fn Choose(d) {
        if (d != this.difficulty) { Click() }
        this.difficulty = d
        for (b in this.buttons) {
            if (b.text == d) { b.set_bg("#8a2f2f") } else { b.set_bg("#2a2a32") }
        }
    }

    fn RandomSeed() {
        Click()
        this.seed = i64(std.os.time() * 1000) % 100000
        this.field.text = str(this.seed)
    }

    fn Enter() {
        let entry = num(this.field.text)
        if (entry) { this.seed = i64(entry) }
        let state = this.state()
        state.seed = this.seed
        state.difficulty = this.difficulty
        state.startFloor = 0
        editor.log(format("Dungeon : graine {}, difficulté {}", this.seed, this.difficulty))
        this.load("generation")
    }

    fn OnStart() {
        # Menu : souris libre, même en plein écran, pour cliquer les boutons.
        input.set_mouse_mode("free")
        Sway("Skull")
        # Musique du titre sur un souffle de caverne ; les torches crépitent
        # d'elles-mêmes (script « torchlight »).
        this.ambience = sounds.Ambience()
        this.ambience.Crossfade([{sound: "game-music-main", volume: 0.45},
                              {sound: "default_ambience_wind_cave_1", volume: 0.2}], 2.0)
        let state = this.state()
        this.seed = state.seed or 1234
        this.difficulty = state.difficulty or "Normal"
        ui.label("LES CRYPTES DE SCRIPT", {anchor: "top_left", offset: [36, 26], font_size: 46, bold: true,
                                           color: "#e8c27a"})
        ui.label("Un donjon différent à chaque graine", {anchor: "top_left", offset: [40, 84], font_size: 17,
                                                         color: "#c9bfae"})

        let panel = ui.column({anchor: "bottom_right", offset: [-40, -44], gap: 10, pad: 24, bg: "#120e0ce0",
                                 radius: 10, w: 360})
        ui.label("Graine du donjon", {parent: panel, bold: true})
        let row = ui.row({parent: panel, gap: 8})
        this.field = ui.input("nombre", fn(w, text) { this.Enter() }, {parent: row, w: 160})
        this.field.text = str(this.seed)
        ui.button("Au hasard", fn(b) { this.RandomSeed() }, {parent: row, w: 110})
        ui.label("Difficulté", {parent: panel, bold: true})
        let choices = ui.row({parent: panel, gap: 6})
        for (d in DIFFICULTIES) {
            this.buttons.append(ui.button(d, fn(b) { this.Choose(d) }, {parent: choices, w: 90}))
        }
        this.Choose(this.difficulty)
        ui.separator({parent: panel})
        ui.button("Entrer dans le donjon", fn(b) { this.Enter() }, {parent: panel, w: 300})
        ui.button("Scénario : les égouts", fn(b) { this.load("sewers") }, {parent: panel, w: 300})
        ui.button("Quitter", fn(b) { this.quit() }, {parent: panel, w: 300})
        ui.label("ZQSD / WASD + souris : explorer · Espace ou clic : frapper · F7 : libérer la souris",
                 {anchor: "bottom", offset: [0, -18], font_size: 13, color: "#c9bfaea0"})
    }

    fn OnUpdate(dt) {
        this.ambience.Update(dt)
        if (input.key("enter")) { this.Enter() }
    }
}
