# ── Piranha : la terreur des canaux ──────────────────────────────────────────
#
# Nage en banc dans l'eau des égouts (jamais hors du canal), suit le joueur
# le long du canal et BONDIT hors de l'eau pour le mordre quand il longe le
# garde-corps ou traverse un pont. Un coup d'épée le tue quand il est en
# l'air.

const m = import "monsters"
const UNDER_WATER = 0.55   # profondeur de nage sous le niveau du sol

class Piranha extends m.Monster {
    let jump = 0
    let baseY = 0

    fn Prepare() {
        this.range = 0.0    # il ne frappe qu'en sautant (cf. special)
        this.detection = 9.0
        this.baseY = this.origin[1] - UNDER_WATER
        this.Place(this.here[0], this.baseY, this.here[2])
        this.Tint("Belly", 70, 86, 74)
    }

    fn CanGo(e, x, z) { return m.InWater(e, x, z) }

    # Le joueur est rarement dans l'eau : on vise sa projection sur le canal.
    fn Aim(e, player) { return [player[0], player[2]] }

    fn Special(e, player, d, dt) {
        if (this.jump > 0) {
            this.jump += dt
            let t = math.min(1, this.jump / 0.7)
            this.Place(this.here[0], this.baseY + math.sin(t * math.pi) * 1.5, this.here[2])
            if (t > 0.45 and t < 0.6 and this.cooldown <= 0 and m.PlaneDistance(this.here, player) < 1.5) {
                this.cooldown = 1.2
                this.HitPlayer()
            }
            if (t >= 1) {
                this.jump = 0
                this.Noise("hit", 0.35)  # retombée
                this.Place(this.here[0], this.baseY, this.here[2])
            }
            return true
        }
        if (d < 1.6 and this.cooldown <= 0) {
            this.jump = 0.001
            this.Noise("hit", 0.5)   # gerbe d'eau en jaillissant
            return true
        }
        return false
    }

    fn Wander(e, dt) {
        # En banc : de petits allers-retours le long du canal.
        let x = this.here[0] + math.sin(this.walk * 0.7) * 0.6
        let z = this.here[2] + math.cos(this.walk * 0.5) * 0.6
        if (this.MoveToward(e, x, z, this.speed * 0.4, dt)) { return this.speed * 0.4 }
        return 0
    }

    fn Animate(dt, pace) {
        node.set_rotation(this.Child("Tail"), 0, math.sin(this.walk * 14) * 28, 0)
        let mouth = 0
        if (this.jump > 0) { mouth = 35 * math.abs(math.sin(this.jump * 18)) }
        node.set_rotation(this.Child("Jaw"), mouth, 0, 0)
        if (this.jump == 0) {
            this.Place(this.here[0], this.baseY + math.sin(this.walk * 3) * 0.04, this.here[2])
        }
    }

    # Mort : il flotte le ventre en l'air puis coule.
    fn Collapse(dt) {
        this.death += dt
        let t = math.min(1, this.death / 1.0)
        this.set_rotation(0, this.cap * 180 / math.pi, t * 180)
        this.Place(this.here[0], this.baseY + 0.2 - t * 0.5, this.here[2])
        if (this.death > 1.3) { this.RemoveSelf() }
    }
}
